{
  "name": "stele-rubbing-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:testdata": "node tools/generate-stele.mjs",
    "bench": "esbuild tools/bench-pipeline.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench.mjs && node node_modules/.cache/bench.mjs",
    "test:acceptance": "esbuild tools/acceptance-test.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/acceptance.mjs && node node_modules/.cache/acceptance.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
